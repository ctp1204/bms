# Sao chép thành itsm/.env rồi đổi giá trị. File .env không được commit.
ITOP_PORT=8000
ITOP_DB_PASSWORD=doi-mat-khau-nay
ITOP_ADMIN_PASSWORD=doi-mat-khau-admin
ITSM_USER=bms-itsm
ITSM_PASSWORD=doi-mat-khau-api
ITSM_CMDB_USER=bms-cmdb
ITSM_CMDB_PASSWORD=doi-mat-khau-cmdb
# Bật bộ nối cảnh báo → ticket khi chạy `npm run start:itsm`
ITSM_ENABLED=1
# Thời gian chờ trước khi cảnh báo warning tạo ticket (mặc định 300 s trong config/itsm.json). Demo: 30.
ITSM_WARNING_HOLD_SEC=30
