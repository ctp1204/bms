# ./install.sh tự tạo dcim/.env với giá trị ngẫu nhiên nếu chưa có. File .env không được commit.
# Chỉ sao chép file này khi muốn tự đặt giá trị.
NETBOX_PORT=8001
NETBOX_DB_PASSWORD=doi-mat-khau-nay
NETBOX_REDIS_PASSWORD=doi-mat-khau-nay
# Ít nhất 50 ký tự
NETBOX_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-50-ky-tu-xxxxxxxxxxxxxxxx
# Ít nhất 50 ký tự; đổi giá trị này thì mọi token API cũ mất hiệu lực
NETBOX_API_TOKEN_PEPPER=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-50-ky-tu-xxxxxxxxxxxxxxxx
NETBOX_ADMIN_PASSWORD=doi-mat-khau-admin
# Tài khoản API bms-dcim (quyền xem/thêm/sửa thiết bị, rack, điện; không được xóa).
# Token gửi đi dạng: Authorization: Bearer nbt_<DCIM_API_KEY>.<DCIM_API_TOKEN>
DCIM_USER=bms-dcim
DCIM_API_KEY=doi12kytuxxx
DCIM_API_TOKEN=doi-thanh-40-ky-tu-chu-va-so-xxxxxxxxxxxx
