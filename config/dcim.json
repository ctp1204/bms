    "ups": "ups1",
    "feeds": [
      { "side": "A", "pdu": "pdua" },
      { "side": "B", "pdu": "pdub" }
    ],
    "pduRatedKw": 140,
    "redundancyMaxPct": 50,
    "rackPduRatedKw": 43
  },

